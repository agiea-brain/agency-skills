{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agiea-brain/agent-skills/main/schema/skill.schema.json",
  "title": "SKILL.md frontmatter",
  "description": "Frontmatter of skills/<creator>/<skill>/SKILL.md. Parallel contract for the web app and server; tools/validate.mjs enforces the same rules without a schema library.",
  "type": "object",
  "required": [
    "name",
    "title",
    "description",
    "category"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 60,
      "description": "Must equal the folder name. Permanent public identity."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Display name, sentence case."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Starts with 'Use this skill when \u2026'. What an agent reads to decide when to fire the skill."
    },
    "category": {
      "type": "string",
      "enum": [
        "Sales",
        "Marketing",
        "RevOps",
        "Customer Success",
        "Leadership",
        "Executive Coaching",
        "Sales Coaching",
        "Hiring",
        "Operations",
        "Finance",
        "Product",
        "Strategy",
        "Implementation"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true,
      "description": "Slugs from schema/taxonomy.json tools. Required when the body names a vendor tool."
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true,
      "description": "Other creator slugs with an existing author.md."
    }
  }
}
